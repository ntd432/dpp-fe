      "CircularEconomyIndicator": "dpp-sustainability:CircularEconomyIndicator",
      "SocialIndicator": "dpp-sustainability:SocialIndicator",
      "SustainabilityAttributes": "dpp-sustainability:SustainabilityAttributes",
      "EnvironmentDeclaration": "dpp-sustainability:EnvironmentDeclaration",
      "EnvironmentalFootprint": "dpp-sustainability:EnvironmentalFootprint",
      "ResourceConsumption": "dpp-sustainability:ResourceConsumption",

      "environmentalFootprint": {
        "@id": "dpp-sustainability:environmentalFootprint",
        "@type": "@id"
      },
