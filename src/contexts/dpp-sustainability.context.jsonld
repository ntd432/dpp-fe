      "LifeCycleAssessment": "dpp-sustainability:LifeCycleAssessment",
      "RenewableNonRenewableContent": "dpp-sustainability:RenewableNonRenewableContent",
      "CommercialSustainableIndicators": "dpp-sustainability:CommercialSustainableIndicators",
      "SocialIndicator": "dpp-sustainability:SocialIndicator",
      "SustainabilityAttributes": "dpp-sustainability:SustainabilityAttributes",
      "EnvironmentDeclaration": "dpp-sustainability:EnvironmentDeclaration",

      "environmentalFootprint": {
        "@id": "dpp-sustainability:environmentalFootprint",
        "@type": "@id"
      },
      "resourceConsumption": {
        "@id": "dpp-sustainability:resourceConsumption",
        "@type": "@id"
      },
      "plasticsRelease": "dpp-sustainability:plasticsRelease",
      "decomposability": "dpp-sustainability:decomposability",
      "sectorSustainabilityIndicators": {
        "@id": "dpp-sustainability:sectorSustainabilityIndicators",
        "@type": "@id"
      },
      "criticalRawMaterial": {
        "@id": "dpp-sustainability:criticalRawMaterial",
        "@type": "@id"
      },
      "lifeCycleAssessment": {
        "@id": "dpp-sustainability:lifeCycleAssessment",
        "@type": "xsd:anyURI"
      },
      "renewableNonRenewableContent": {
        "@id": "dpp-sustainability:renewableNonRenewableContent",
        "@type": "@id"
      },
      "commercialSustainableIndicators": {
        "@id": "dpp-sustainability:commercialSustainableIndicators",
        "@type": "@id"
      },
      "labourConditions": "dpp-sustainability:labourConditions",
      "resourceConsumptionWhenUsing": {
