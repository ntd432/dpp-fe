        "@id": "dpp-sustainability:sectorSustainabilityIndicators",
        "@type": "@id"
      },
      "criticalRawMaterial": {
        "@id": "dpp-sustainability:criticalRawMaterial",
        "@type": "@id"
      },
      "lifeCycleAssessmentReport": {
        "@id": "dpp-sustainability:lifeCycleAssessmentReport",
        "@type": "xsd:anyURI"
      },
      "environmentalImpact": {
        "@id": "dpp-sustainability:environmentalImpact",
        "@type": "@id"
      },
      "impactCategory": "dpp-sustainability:impactCategory",
      "method": "dpp-sustainability:method",
      "characterizationFactor": "dpp-sustainability:characterizationFactor",
      "characterizationModel": "dpp-sustainability:characterizationModel",
      "impactIndicator": {
        "@id": "dpp-sustainability:impactIndicator",
        "@type": "@id"
      },
      "renewableNonRenewableContent": {
        "@id": "dpp-sustainability:renewableNonRenewableContent",
        "@type": "@id"
      },
