        "@type": "@id"
      },
      "resourceConsumptionWhenRecovering": {
        "@id": "dpp-sustainability:resourceConsumptionWhenRecovering",
        "@type": "@id"
      },
      "environmentDeclaration": {
        "@id": "dpp-sustainability:environmentDeclaration",
        "@type": "xsd:anyURI"
      },
      "environmentalFootprintType": "dpp-sustainability:environmentalFootprintType",
