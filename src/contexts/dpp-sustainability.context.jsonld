{
  "@context": [
    "./base.context.jsonld",
    "./dpp-core.context.jsonld",
    {
      "SustainabilityInformation": "dpp-sustainability:SustainabilityInformation",
      "SustainabilityPerformance": "dpp-sustainability:SustainabilityPerformance",
      "Decomposability": "dpp-sustainability:Decomposability",
      "SectorSustainabilityIndicators": "dpp-sustainability:SectorSustainabilityIndicators",
