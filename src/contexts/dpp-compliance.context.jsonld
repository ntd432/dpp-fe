{
  "@context": [
    "./base.context.jsonld",
    "./dpp-core.context.jsonld",
    {
      "Compliance": "dpp-compliance:Compliance",
      "Regulation": "dpp-compliance:Regulation",
      "ProductLabel": "dpp-compliance:ProductLabel",
      "ProductStatusAssessment": "dpp-compliance:ProductStatusAssessment",
      "Certification": "dpp-compliance:Certification",
      "DataManagementMethod": "dpp-compliance:DataManagementMethod",

      "regulation": {
        "@id": "dpp-compliance:regulation",
        "@type": "@id"
      },
      "Label": "dpp-compliance:Label",
      "productLabel": {
        "@id": "dpp-compliance:productLabel",
        "@type": "@id"
      },
      "labelName": "dpp-compliance:labelName",
      "labelDescription": "dpp-compliance:labelDescription",
      "labelValue": "dpp-compliance:labelValue",
      "labelDocumentation": {
        "@id": "dpp-compliance:labelDocumentation",
        "@type": "xsd:anyURI"
      },
      "productStatusAssessment": {
        "@id": "dpp-compliance:productStatusAssessment",
        "@type": "xsd:anyURI"
      },
      "certification": {
        "@id": "dpp-compliance:certification",
        "@type": "@id"
      },
      "dataManagementMethod": {
        "@id": "dpp-compliance:dataManagementMethod",
        "@type": "@id"
      }
    }
  ]
}